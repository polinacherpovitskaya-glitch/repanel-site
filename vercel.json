{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "https://site.re-panel.ru/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://site.re-panel.ru/:path*",
      "permanent": false
    }
  ]
}
